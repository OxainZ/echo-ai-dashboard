# API Keys for Data Providers
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
QUANDL_API_KEY=your_quandl_api_key_here
YAHOO_FINANCE_API_KEY=optional_yahoo_finance_api_key

# Database Configuration (if needed for persistence)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=echo_trading
DB_USER=echo_user
DB_PASSWORD=your_secure_password

# Model Configuration
MODEL_SAVE_PATH=./models
MODEL_CHECKPOINT_PATH=./checkpoints
ENABLE_MODEL_RETRAINING=true
RETRAINING_INTERVAL_HOURS=24

# Trading Configuration
ENABLE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
MAX_POSITION_SIZE_USD=10000
RISK_TOLERANCE=medium

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/trading.log
ENABLE_SENSITIVE_DATA_LOGGING=false

# Security
SECRET_KEY=your_secret_key_here_change_in_production
PASSWORD_HASH=c3499c2729730a7f807efb8676a92dcb6f8a3f8f0675b84d7f3142c3c7

# Dashboard Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
AUTO_REFRESH_INTERVAL_SECONDS=30

# Compliance & Ethics
DATA_RETENTION_DAYS=365
ENABLE_AUDIT_LOGGING=true
REQUIRE_DISCLAIMER_ACCEPTANCE=true
