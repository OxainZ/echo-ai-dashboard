# Echo AI Dashboard Environment Configuration
# Copy this file to .env and fill in your values

# Authentication
# Generate using: python -c "import hashlib; print(hashlib.sha256('your_password'.encode()).hexdigest())"
PASSWORD_HASH=your_generated_password_hash_here

# API Keys (Optional - for future data providers)
# ALPHA_VANTAGE_API_KEY=your_key_here
# POLYGON_API_KEY=your_key_here
# FINNHUB_API_KEY=your_key_here

# Application Settings
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Data Provider Configuration
DEFAULT_DATA_PROVIDER=yfinance
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

# Risk Management
MAX_RISK_PER_TRADE_USD=75
MAX_SLOT_RISK_USD=100
CASH_BUFFER_PERCENT=5

# Dashboard Configuration
AUTO_REFRESH_INTERVAL=5
TIMEZONE=America/Chicago
