# Echo AI Dashboard Environment Variables
# Copy this file to .env and fill in your values

# Application Settings
APP_NAME=Echo AI Trading Dashboard
APP_VERSION=1.0.0
ENVIRONMENT=production

# Security
# Generate a secure password hash: python -c "import hashlib; print(hashlib.sha256(b'your_password').hexdigest())"
PASSWORD_HASH=c3499c2729730a7f807efb8676a92dcb6f8a3f8f0675b84d7f3142c3c7

# API Keys (if using external services)
# ALPHA_VANTAGE_API_KEY=your_key_here
# FINNHUB_API_KEY=your_key_here
# NEWS_API_KEY=your_key_here

# Database (if needed)
# DATABASE_URL=postgresql://user:password@localhost:5432/echo_db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/echo.log

# Trading Configuration
INITIAL_CAPITAL=100000
MAX_POSITION_SIZE=0.25
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.10

# Data Provider Settings
DATA_PROVIDER=yfinance
CACHE_ENABLED=true
CACHE_EXPIRY_SECONDS=300

# ML Model Settings
MODEL_PATH=models/
ENABLE_AI_PREDICTIONS=true
LSTM_SEQUENCE_LENGTH=60
MODEL_RETRAIN_INTERVAL_DAYS=7

# Feature Flags
ENABLE_SENTIMENT_ANALYSIS=false
ENABLE_BACKTESTING=true
ENABLE_MULTI_ASSET=false

# Deployment
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
