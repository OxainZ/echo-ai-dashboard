# Echo AI Dashboard Environment Configuration
# Copy this file to .env and fill in your values

# Application Settings
APP_ENV=development
DEBUG=false

# Security - Password hash for dashboard access
# Generate with: python -c "import hashlib; print(hashlib.sha256('your_password'.encode()).hexdigest())"
PASSWORD_HASH=c3499c2729730a7f807efb8676a92dcb6f8a3f8f0675b84d7f3142c3c7

# Data Provider API Keys
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
QUANDL_API_KEY=your_quandl_api_key_here

# News & Sentiment Analysis
NEWS_API_KEY=your_news_api_key_here
FINBERT_MODEL_PATH=ProsusAI/finbert

# Database (if used for portfolio tracking)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=echo_ai
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Redis Cache (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cloud Storage (optional for data caching)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Application Configuration
CACHE_TTL_SECONDS=300
MAX_RETRIES=3
REQUEST_TIMEOUT=30

# Trading Configuration
DEFAULT_TIMEZONE=America/Chicago
ENABLE_BACKTESTING=true
ENABLE_ML_PREDICTIONS=true
ENABLE_SENTIMENT_ANALYSIS=true

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/echo_ai.log
