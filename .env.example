# Echo AI Dashboard - Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control

# Dashboard Authentication
# Generate password hash: python -c "import hashlib; print(hashlib.sha256('your_password'.encode()).hexdigest())"
PASSWORD_HASH=your_password_hash_here

# API Keys (Optional - for future integrations)
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
# FINNHUB_API_KEY=your_finnhub_key_here
# QUANDL_API_KEY=your_quandl_key_here

# Database Configuration (if needed in future)
# DATABASE_URL=your_database_url_here

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=America/Chicago

# Feature Flags
ENABLE_AI_PREDICTIONS=true
ENABLE_REALTIME_DATA=true
ENABLE_NOTIFICATIONS=false
